{
    "name": "@org/backend",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "targets": {
            "build": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "webpack-cli build",
                    "args": [
                        "--node-env=production"
                    ],
                    "cwd": "apps/backend"
                },
                "configurations": {
                    "development": {
                        "args": [
                            "--node-env=development"
                        ]
                    }
                }
            },
            "prune-lockfile": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "executor": "@nx/js:prune-lockfile",
                "outputs": [
                    "{workspaceRoot}/backend/dist/package.json",
                    "{workspaceRoot}/backend/dist/package-lock.json"
                ],
                "options": {
                    "buildTarget": "build"
                }
            },
            "copy-workspace-modules": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "outputs": [
                    "{workspaceRoot}/backend/dist/workspace_modules"
                ],
                "executor": "@nx/js:copy-workspace-modules",
                "options": {
                    "buildTarget": "build"
                }
            },
            "prune": {
                "dependsOn": [
                    "prune-lockfile",
                    "copy-workspace-modules"
                ],
                "executor": "nx:noop"
            },
            "serve": {
                "continuous": true,
                "executor": "@nx/js:node",
                "defaultConfiguration": "development",
                "dependsOn": [
                    "build"
                ],
                "options": {
                    "buildTarget": "@org/backend:build",
                    "runBuildTargetDependencies": false
                },
                "configurations": {
                    "development": {
                        "buildTarget": "@org/backend:build:development"
                    },
                    "production": {
                        "buildTarget": "@org/backend:build:production"
                    }
                }
            }
        }
    },
    "dependencies": {
        "@nestjs-modules/mailer": "^2.3.6",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mapped-types": "*",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.27",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/serve-static": "^5.0.5",
        "@nestjs/typeorm": "^11.0.1",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "handlebars": "^4.7.9",
        "ioredis": "^5.11.1",
        "multer": "^2.2.0",
        "nodemailer": "^8.0.10",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.21.0",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.0",
        "tslib": "^2.3.0",
        "typeorm": "^1.0.0",
        "uuid": "^14.0.0"
    },
    "devDependencies": {
        "@nestjs/testing": "^11.0.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/multer": "^2.1.0",
        "@types/nodemailer": "^8.0.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/uuid": "^10.0.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0"
    },
    "scripts": {
        "seed": "npx ts-node -r tsconfig-paths/register src/database/seeds/super-admin.seed.ts"
    }
}
