<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <style>
    body { font-family: Arial, sans-serif; background: #f9f9f9; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 40px auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
    .header { background: rgba(101,16,127,1); padding: 32px; text-align: center; }
    .header h1 { color: #fff; margin: 0; font-size: 24px; }
    .header p { color: rgba(255,255,255,0.7); margin: 8px 0 0; font-size: 14px; }
    .body { padding: 40px 32px; }
    .body p { color: #444; font-size: 15px; line-height: 1.6; }
    .btn { display: inline-block; margin: 24px 0; padding: 14px 32px; background: rgba(101,16,127,1); color: #fff; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 15px; }
    .token-box { background: #f5edf9; border: 1px dashed rgba(101,16,127,0.3); border-radius: 8px; padding: 16px; text-align: center; margin: 20px 0; }
    .token { font-size: 22px; font-weight: bold; color: rgba(101,16,127,1); letter-spacing: 3px; }
    .footer { background: #f9f9f9; padding: 20px 32px; text-align: center; }
    .footer p { color: #aaa; font-size: 12px; margin: 0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Servify</h1>
      <p>Multi-Tenant Customer Service Platform</p>
    </div>
    <div class="body">
      <p>Hello {{name}},</p>
      <p>{{message}}</p>
      <div class="token-box">
        <p style="margin:0 0 8px;color:#888;font-size:13px;">Your Registration Token</p>
        <div class="token">{{token}}</div>
      </div>
      <p>Click the button below to complete your registration:</p>
      <a href="{{registerUrl}}" class="btn">Complete Registration</a>
      <p style="font-size:13px;color:#888;">This invitation expires in <strong>{{expiresIn}}</strong>. If you did not request this, please ignore this email.</p>
    </div>
    <div class="footer">
      <p>© 2026 Servify. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
